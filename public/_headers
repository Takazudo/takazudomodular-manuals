# script-src allows static.cloudflareinsights.com for the edge-injected
# Cloudflare Web Analytics beacon — rationale in doc/.../infrastructure/csp.md
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-hIolMSvWhopr46DqQi50arv0b3/qeN3LLlH0NTMq3K8='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'

/doc
  ! Content-Security-Policy
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'

/doc/*
  ! Content-Security-Policy
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'

# Content-hashed JS/CSS bundles — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Rendered PDF page PNGs (and thumbs) under each manual — immutable.
/*/pages/*
  Cache-Control: public, max-age=31536000, immutable
/*/thumbs/*
  Cache-Control: public, max-age=31536000, immutable

# JSON data (manifest / pages-ja / pages-en / search-index) is fetched at
# runtime by the islands; revalidate so content updates show without a hard
# cache bust (search fetches already carry ?v=<hash>).
/*/data/*
  Cache-Control: public, max-age=0, must-revalidate
