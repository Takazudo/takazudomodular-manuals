{
  "name": "takazudomodular-manuals",
  "version": "0.0.1",
  "description": "Takazudo Modular: Manuals - Hardware synthesizer manuals with Japanese translations",
  "private": true,
  "type": "module",
  "author": "Takazudo",
  "keywords": [
    "manual",
    "oxi-one-mkii",
    "synthesizer",
    "zfb",
    "preact",
    "japanese"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "// ── App ──────────────────────────────────────": "",
    "predev": "lsof -ti :3300 | xargs kill 2>/dev/null; true",
    "dev": "zfb dev",
    "predev:net": "lsof -ti :3300 | xargs kill 2>/dev/null; true",
    "dev:net": "zfb dev --host 0.0.0.0",
    "build": "pnpm run pdf:search-index:all && zfb build && node scripts/zfb-finalize-build.js && pnpm run doc:build && mkdir -p dist/manuals/doc && cp -r doc/build/* dist/manuals/doc/",
    "preview": "zfb preview",
    "preserve": "lsof -ti :8030 | xargs kill 2>/dev/null; true",
    "serve": "pnpm dlx serve dist -l 8030",
    "preserve:net": "lsof -ti :8030 | xargs kill 2>/dev/null; true",
    "serve:net": "pnpm dlx serve dist --listen tcp://0.0.0.0:8030",
    "// ── Documentation ────────────────────────────": "",
    "predoc:dev": "lsof -ti :3100 | xargs kill 2>/dev/null; true",
    "doc:dev": "cd doc && pnpm run start",
    "predoc:dev:net": "lsof -ti :3100 | xargs kill 2>/dev/null; true",
    "doc:dev:net": "cd doc && docusaurus start --port 3100 --host 0.0.0.0",
    "doc:build": "cd doc && pnpm run build",
    "doc:serve": "cd doc && pnpm run serve",
    "doc:serve:net": "cd doc && docusaurus serve --host 0.0.0.0",
    "// ── PDF Processing ───────────────────────────": "",
    "thumbs:generate": "node scripts/generate-thumbs.js --all",
    "thumbs:generate:slug": "node scripts/generate-thumbs.js",
    "pdf:split": "node scripts/pdf-split.js",
    "pdf:render": "node scripts/pdf-render-pages.js",
    "pdf:extract": "node scripts/pdf-extract-text.js",
    "pdf:translate": "echo 'Translation is handled by Claude Code Task subagents during /l-pdf-process execution' && exit 1",
    "pdf:validate": "node scripts/check-page-numbers.js",
    "pdf:fix": "node scripts/fix-page-numbers.js",
    "pdf:build": "node scripts/check-page-numbers.js && node scripts/pdf-build.js",
    "pdf:search-index": "node scripts/pdf-search-index.js",
    "pdf:search-index:all": "node scripts/pdf-search-index-all.js",
    "pdf:manifest": "node scripts/pdf-manifest.js",
    "pdf:clean": "node scripts/pdf-clean.js",
    "pdf:clean-en": "node scripts/pdf-clean-en.js",
    "pdf:clean-en:all": "node scripts/pdf-clean-en.js --all",
    "pdf:md-to-html": "node scripts/pdf-md-to-html.js",
    "pdf:md-to-html:all": "node scripts/pdf-md-to-html.js --all",
    "pdf:verify": "node scripts/pdf-verify.js",
    "pdf:all": "node scripts/pdf-all.js",
    "gen:registry": "node scripts/gen-registry.js",
    "// ── Quality ──────────────────────────────────": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,json,css,yml,yaml}\" \"!**/*.{md,mdx}\" \"!node_modules/**\" \"!dist/**\" \"!worktrees/**\" \"!__inbox/**\" && pnpm run format:md:check",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,json,css,yml,yaml}\" \"!**/*.{md,mdx}\" \"!node_modules/**\" \"!dist/**\" \"!worktrees/**\" \"!__inbox/**\" && pnpm run format:md",
    "format:md": "node scripts/md-formatter/src/cli.js --write \"**/*.{md,mdx}\"",
    "format:md:check": "node scripts/md-formatter/src/cli.js --check \"**/*.{md,mdx}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "check:fix": "pnpm run lint:fix && pnpm run format:fix",
    "// ── Testing ──────────────────────────────────": "",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "node scripts/test-all-pages-fast.js",
    "test:e2e": "playwright test e2e/all-pages.spec.ts",
    "// ── Deploy ───────────────────────────────────": "",
    "deploy:preview": "wrangler pages deploy dist --project-name=zmanuals --branch=preview",
    "deploy:prod": "wrangler pages deploy dist --project-name=zmanuals --branch=main",
    "// ── Utilities ────────────────────────────────": "",
    "clean": "rm -rf .zfb-build dist doc/build doc/.docusaurus",
    "init-worktree": "./scripts/setup-worktree-env.sh",
    "b4push": "./scripts/b4push.sh",
    "prepare": "pnpm dlx husky"
  },
  "dependencies": {
    "@netlify/classnames-template-literals": "^1.0.3",
    "@takazudo/zfb": "0.1.0-next.36",
    "@takazudo/zfb-runtime": "0.1.0-next.36",
    "minisearch": "^7.2.0",
    "preact": "^10.22.0",
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas": "^3.2.2",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "glob": "^13.0.6",
    "image-size": "^2.0.2",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdf-to-png-converter": "^3.14.0",
    "pdfjs-dist": "^5.5.207",
    "prettier": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^1.6.1",
    "wrangler": "^4.77.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "node scripts/md-formatter/src/cli.js --write"
    ],
    "!(worktrees|__inbox)/**/*.{md,mdx}": [
      "node scripts/md-formatter/src/cli.js --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ],
    "!(worktrees|__inbox|node_modules)/**/*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
